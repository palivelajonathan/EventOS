# ==============================================================================
# EVENTOS ENVIRONMENT VARIABLES (.env.example)
# Production SaaS Configuration
# ==============================================================================

# Supabase Public API (Accessible from browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Supabase Service Role Key (SERVER ONLY - NEVER expose to browser)
# Used for administrative operations, atomic check-ins, batch participant imports
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# EventOS System Secrets
EVENTOS_SECRET_KEY=eventos_prod_secret_key_change_me_in_production
APP_URL=http://localhost:3000

# AI Intelligence Co-Pilot & WhatsApp Concierge (Groq LPU Inference)
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Meta WhatsApp Cloud API & Webhooks
# WHATSAPP_VERIFY_TOKEN: Custom secret string entered into Meta App Dashboard -> WhatsApp -> Configuration -> Webhook
WHATSAPP_VERIFY_TOKEN=your_custom_whatsapp_verify_token
# WHATSAPP_ACCESS_TOKEN: Meta Graph API System User / Permanent Token for outbound messages (NEVER use for verification)
WHATSAPP_ACCESS_TOKEN=EAAG...
WHATSAPP_PHONE_NUMBER_ID=100000000000000
WHATSAPP_TEMPLATE_NAME=eventos_pass_confirmation

# Outbound Webhooks (n8n, Slack, Zapier, etc. - Optional)
N8N_WEBHOOK_URL=https://n8n.yourdomain.com/webhook/eventos

